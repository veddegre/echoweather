# Block direct web access to local config (Apache).
<Files "config.local.php">
    Require all denied
</Files>

# Dev-only router and server-side paths — not for production HTTP.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^lib/ - [F,L]
    RewriteRule ^cache/ - [F,L]
    RewriteRule ^pooh/cache/ - [F,L]
    RewriteRule ^router\.php$ - [F,L]
    # API routes — backup when api/.htaccess is not applied on the host.
    RewriteRule ^api/hms-smoke$ api/hms-smoke.php [L,QSA]
    RewriteRule ^api/wpc-ero$ api/wpc-ero.php [L,QSA]
    RewriteRule ^api/nhc-storms$ api/nhc-storms.php [L,QSA]
    RewriteRule ^api/7timer$ api/7timer.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self)"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://cdnjs.cloudflare.com https://*.basemaps.cartocdn.com https://*.tile.opentopomap.org https://services.arcgisonline.com https://server.arcgisonline.com https://mesonet.agron.iastate.edu https://opengeo.ncep.noaa.gov https://tilecache.rainviewer.com https://*.rainviewer.com; connect-src 'self' https://api.weather.gov https://api.open-meteo.com https://air-quality-api.open-meteo.com https://geocoding-api.open-meteo.com https://marine-api.open-meteo.com https://archive-api.open-meteo.com https://api.bigdatacloud.net https://api.rainviewer.com https://*.rainviewer.com https://www.spc.noaa.gov https://services.swpc.noaa.gov https://mesonet.agron.iastate.edu https://mapservices.weather.noaa.gov https://opengeo.ncep.noaa.gov https://services5.arcgis.com https://api.water.noaa.gov https://waterservices.usgs.gov https://api.tidesandcurrents.noaa.gov https://api.allorigins.win https://static.cloudflareinsights.com https://cloudflareinsights.com wss://ws1.blitzortung.org wss://ws7.blitzortung.org wss://ws8.blitzortung.org; worker-src 'self'; manifest-src 'self'"

    # App shell should always revalidate so deploys take effect immediately.
    <FilesMatch "^(index\.html|sw\.js)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # PWA icons & branding — avoid stale CDN/browser caches after updates.
    <FilesMatch "^(apple-touch-icon|icon-192|icon-512)\.png$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
    <FilesMatch "^(icon|icon-maskable|logo)\.svg$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>
